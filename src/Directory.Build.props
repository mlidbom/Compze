<Project>
  <!-- Import root-level Directory.Build.props (JetBrains.Annotations + FlexRef infrastructure) -->
  <Import Project="$([MSBuild]::GetPathOfFileAbove('Directory.Build.props', '$(MSBuildThisFileDirectory)..'))" />
  <!-- Enable package validation for all projects -->
  <Import Project="msbuild\EnablePackageValidation.props" />
  <!-- Ensure test configuration file exists before build -->
  <Import Project="msbuild\EnsurePluggableComponentsConfigExists.props" />
	<PropertyGroup>
      <ImplicitUsings>enable</ImplicitUsings>
	</PropertyGroup>
  <!-- Every project targets .NET 11, unless its own project file says otherwise, as the three netstandard2.0 libraries do:
       Compze.Contracts, Compze.Unit and Compze.Underscore. And every project compiles with the newest C# its compiler has,
       which is the same everywhere because global.json pins the SDK. -->
  <PropertyGroup>
    <TargetFramework>net11.0</TargetFramework>
    <LangVersion>latest</LangVersion>
  </PropertyGroup>
  <!-- Enable latest analyzer rules for all projects -->
  <PropertyGroup>
    <AnalysisLevel>latest-all</AnalysisLevel>
    <RunAnalyzersDuringLiveAnalysis>False</RunAnalyzersDuringLiveAnalysis>
    <NuGetAuditMode>direct</NuGetAuditMode>
  </PropertyGroup>
  <!-- The threading analyzers, in every project. Among them, VSTHRD002 flags a synchronous wait on a task (.Wait(), .Result,
       GetAwaiter().GetResult()) wherever it is: no rule of AnalysisLevel latest-all does, as CA1849 flags one only inside a
       method that returns a task. Such a wait needs a free thread-pool thread, and stalls while the pool is busy. Private
       assets, so that no Compze package depends on it. -->
  <ItemGroup>
    <PackageReference Include="Microsoft.VisualStudio.Threading.Analyzers" Version="18.12.1" PrivateAssets="all" IncludeAssets="runtime; build; native; contentfiles; analyzers; buildtransitive" />
  </ItemGroup>
  <Import Project="msbuild\IncludeTestConfigurationFiles.props" Condition="'$(IsTestProject)' == 'true'" />
  <Import Project="msbuild\IncludeTestAppSettings.props" Condition="'$(IsTestProject)' == 'true'" />
  <!-- NuGet package metadata for library projects -->
  <PropertyGroup Condition="'$(IsTestProject)' != 'true' AND '$(IsPackable)' != 'false'">
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <Authors>Lidbom Solutions AB</Authors>
    <PackageLicenseExpression>Apache-2.0</PackageLicenseExpression>
    <PackageProjectUrl>https://github.com/mlidbom/Compze</PackageProjectUrl>
    <RepositoryUrl>https://github.com/mlidbom/Compze.git</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <PackageTags>compze;messaging;event-sourcing;cqrs</PackageTags>
    <Copyright>Copyright (c) Lidbom Solutions AB. All rights reserved.</Copyright>
    <PublishRepositoryUrl>true</PublishRepositoryUrl>
    <EmbedUntrackedSources>true</EmbedUntrackedSources>
    <IncludeSymbols>true</IncludeSymbols>
    <SymbolPackageFormat>snupkg</SymbolPackageFormat>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <PackageIcon>compze-icon.png</PackageIcon>
  </PropertyGroup>
  <ItemGroup Condition="'$(IsTestProject)' != 'true' AND '$(IsPackable)' != 'false'">
    <None Include="$(MSBuildProjectDirectory)/README.md" Pack="true" PackagePath="" />
    <None Include="$(MSBuildThisFileDirectory)../compze-icon.png" Pack="true" PackagePath="" />
  </ItemGroup>
</Project>