<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <Nullable>enable</Nullable>
    <Version>0.1.0-alpha.1</Version>
    <Description>A MemoryPack cache for Compze.Teventive.StateStore's JSON files, so a state store kept in files starts from the cache and reads only the files changed since.</Description>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="MemoryPack" Version="1.21.4" />
  </ItemGroup>
  <!-- Compze.Contracts — flex reference -->
  <ItemGroup Condition="'$(UsePackageReference_Compze_Contracts)' == 'true'">
    <PackageReference Include="Compze.Contracts" Version="*-*" />
  </ItemGroup>
  <ItemGroup Condition="'$(UsePackageReference_Compze_Contracts)' != 'true'">
    <ProjectReference Include="..\Compze.Contracts\Compze.Contracts.csproj" />
  </ItemGroup>
  <!-- Compze.Teventive.StateStore — flex reference -->
  <ItemGroup Condition="'$(UsePackageReference_Compze_Teventive_StateStore)' == 'true'">
    <PackageReference Include="Compze.Teventive.StateStore" Version="*-*" />
  </ItemGroup>
  <ItemGroup Condition="'$(UsePackageReference_Compze_Teventive_StateStore)' != 'true'">
    <ProjectReference Include="..\Compze.Teventive.StateStore\Compze.Teventive.StateStore.csproj" />
  </ItemGroup>
</Project>