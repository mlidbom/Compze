<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <Nullable>enable</Nullable>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <Version>0.10.0-alpha</Version>
    <Description>Cross-process synchronization for Compze.Threading. A system-mutex-backed IAwaitableMutex that offers the full Monitor.Wait condition-wait model across process boundaries, plus IProcessShared/IAwaitableProcessShared, the file-based InterprocessSignal, IProcessLock, a lock between processes that any thread can release and the operating system releases when its holder dies, and IInterprocessObject, an object shared between processes, created in a single line of code, with atomic updates, waits for conditions to become true, recovery from corruption and pluggable serialization. Extracted from Compze.Threading 0.7.0-alpha; IInterprocessObject moved here from the retired Compze.InterprocessObject.</Description>
  </PropertyGroup>
  <ItemGroup>
    <InternalsVisibleTo Include="Compze.Threading.InternalSpecifications" />
  </ItemGroup>
  <!-- Compze.Contracts — flex reference -->
  <ItemGroup Condition="'$(UsePackageReference_Compze_Contracts)' == 'true'">
    <PackageReference Include="Compze.Contracts" Version="*-*" />
  </ItemGroup>
  <ItemGroup Condition="'$(UsePackageReference_Compze_Contracts)' != 'true'">
    <ProjectReference Include="..\Compze.Contracts\Compze.Contracts.csproj" />
  </ItemGroup>
  <!-- Compze.Internals.SystemCE — flex reference -->
  <ItemGroup Condition="'$(UsePackageReference_Compze_Internals_SystemCE)' == 'true'">
    <PackageReference Include="Compze.Internals.SystemCE" Version="*-*" />
  </ItemGroup>
  <ItemGroup Condition="'$(UsePackageReference_Compze_Internals_SystemCE)' != 'true'">
    <ProjectReference Include="..\Compze.Internals.SystemCE\Compze.Internals.SystemCE.csproj" />
  </ItemGroup>
  <!-- Compze.Threading — flex reference -->
  <ItemGroup Condition="'$(UsePackageReference_Compze_Threading)' == 'true'">
    <PackageReference Include="Compze.Threading" Version="*-*" />
  </ItemGroup>
  <ItemGroup Condition="'$(UsePackageReference_Compze_Threading)' != 'true'">
    <ProjectReference Include="..\Compze.Threading\Compze.Threading.csproj" />
  </ItemGroup>
</Project>