<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <!-- The experiments are built against the packages nuget.org has released, not against the repository's local feed. -->
  <packageSources>
    <clear />
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" />
  </packageSources>
  <packageSourceMapping>
    <clear />
  </packageSourceMapping>
</configuration>
