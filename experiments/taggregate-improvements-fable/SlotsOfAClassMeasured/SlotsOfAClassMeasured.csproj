<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net11.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <ServerGarbageCollection>false</ServerGarbageCollection>
    <ConcurrentGarbageCollection>false</ConcurrentGarbageCollection>
    <TieredPGO>true</TieredPGO>
    <CompzeConfiguration Condition="'$(CompzeConfiguration)' == ''">Debug</CompzeConfiguration>
    <NoWarn>CS0108;CS0618;CA1715</NoWarn>
    <!-- Built against this worktree's Compze.Teventive, as a build of src/Compze.Teventive leaves it. -->
    <CompzeBin>$(MSBuildThisFileDirectory)..\..\..\src\Compze.Teventive\bin\$(CompzeConfiguration)\net11.0</CompzeBin>
  </PropertyGroup>
  <ItemGroup>
    <Reference Include="$(CompzeBin)\Compze.*.dll" />
  </ItemGroup>
</Project>
