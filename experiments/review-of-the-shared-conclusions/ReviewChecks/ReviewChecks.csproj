<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net11.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <NoWarn>CS0108;CS0618;CA1715</NoWarn>
    <!-- Built against this worktree's Compze.Teventive, the static-slots prototype, as a Release build of src/Compze.Teventive leaves it. -->
    <CompzeBin>$(MSBuildThisFileDirectory)..\..\..\src\Compze.Teventive\bin\Release\net11.0</CompzeBin>
  </PropertyGroup>
  <ItemGroup>
    <Reference Include="$(CompzeBin)\Compze.*.dll" />
  </ItemGroup>
</Project>
